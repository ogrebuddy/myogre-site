---
export interface Props {
  title: string;
  description: string;
  href: string;
  badge?: string;
  icon?: string;
  iconSize?: 'normal' | 'large';
  disabled?: boolean;
  external?: boolean;
}

const { 
  title, 
  description, 
  href, 
  badge, 
  icon = "/assets/buddy-purple.png", 
  iconSize = 'normal',
  disabled = false,
  external = false
} = Astro.props;
---

<a 
  href={disabled ? '#' : href} 
  target={external ? "_blank" : undefined} 
  rel={external ? "noopener noreferrer" : undefined}
  class={`bodega-card-link ${disabled ? 'disabled-card' : ''}`}
>
  <article class="bodega-card">
    <div class="card-top">
      {icon.endsWith('.png') || icon.endsWith('.svg') ? (
        <img src={icon} alt="" class={`card-icon-img ${iconSize === 'large' ? 'icon-large' : ''}`} />
      ) : (
        <span class="card-icon">{icon}</span>
      )}
      {badge && <span class="stamp-pill card-stamp">{badge}</span>}
    </div>
    
    <h3 class="card-title">
      <span>{title} &rarr;</span>
    </h3>

    <p class="card-desc">{description}</p>
  </article>
</a>

<style>
  .bodega-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
    width: 100%;
  }

  .bodega-card-link:hover .bodega-card {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 var(--text-main);
  }

  body.theme-neon .bodega-card-link:hover .bodega-card {
    border-color: var(--neon-pink);
    box-shadow: 0 0 22px rgba(255, 79, 163, 0.55), inset 0 0 10px rgba(255, 79, 163, 0.15);
  }

  .bodega-card-link:hover .card-title {
    color: var(--accent-color);
  }

  body.theme-neon .bodega-card-link:hover .card-title {
    color: var(--neon-pink);
    text-shadow: 0 0 8px var(--neon-pink);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .card-icon-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
    transition: transform 0.2s ease;
  }

  /* 3x size for large logo icons */
  .card-icon-img.icon-large {
    width: 96px;
    height: 96px;
  }

  .bodega-card-link:hover .card-icon-img {
    transform: scale(1.06);
  }

  .card-icon {
    font-size: 1.5rem;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--text-main);
    margin-bottom: 0.4rem;
    transition: color 0.15s ease;
  }

  .card-desc {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  .disabled-card {
    opacity: 0.85;
    pointer-events: none;
  }
</style>
