---
export interface Props {
  text?: string;
}

const {
  text = "Hi. I’m Ogre. Robin is building me into a personal assistant, virtual companion, and increasingly elaborate collection of useful experiments."
} = Astro.props;
---

<div class="speech-bubble-container" id="speech-bubble-container">
  <div class="speech-bubble-box">
    <div class="bubble-tail-left"></div>
    <p class="speech-text">{text}</p>
  </div>
</div>

<style>
  .speech-bubble-container {
    position: relative;
    flex: 1;
    max-width: 580px;
    opacity: 0;
    transform: translateX(12px) scale(0.96);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .speech-bubble-container.visible {
    opacity: 1;
    transform: translateX(0) scale(1);
  }

  .speech-bubble-box {
    position: relative;
    background: #ffffff;
    border: 3.5px solid #111111;
    border-radius: 24px;
    padding: 1.5rem 1.8rem;
    box-shadow: 
      6px 6px 0 #111111,
      -3px -3px 0 rgba(0, 0, 0, 0.05);
    text-align: left;
  }

  /* Halftone shadow effect under bubble */
  .speech-bubble-box::after {
    content: '';
    position: absolute;
    bottom: -12px;
    right: -10px;
    left: 20px;
    height: 12px;
    background-image: radial-gradient(#111 1.3px, transparent 1.3px);
    background-size: 6px 6px;
    opacity: 0.45;
    z-index: -1;
    pointer-events: none;
  }

  /* Tail pointing LEFT toward the Ogre mascot on desktop */
  .bubble-tail-left {
    position: absolute;
    left: -20px;
    bottom: 28px;
    width: 0;
    height: 0;
    border-top: 14px solid transparent;
    border-bottom: 14px solid transparent;
    border-right: 22px solid #111111;
    transition: all 0.3s ease;
  }

  .bubble-tail-left::after {
    content: '';
    position: absolute;
    left: 4px;
    top: -10px;
    width: 0;
    height: 0;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    border-right: 17px solid #ffffff;
    transition: all 0.3s ease;
  }

  .speech-text {
    font-family: var(--font-mono);
    font-size: clamp(0.85rem, 2vw, 1.02rem);
    font-weight: 600;
    color: #111111;
    line-height: 1.45;
    margin: 0;
  }

  /* Bodega Neon Mode */
  body.theme-neon .speech-bubble-box {
    background: #190f2a;
    border-color: var(--neon-cyan);
    box-shadow: 0 0 18px rgba(92, 242, 255, 0.4);
  }

  body.theme-neon .speech-text {
    color: #f3e9ff;
  }

  body.theme-neon .bubble-tail-left {
    border-right-color: var(--neon-cyan);
  }

  body.theme-neon .bubble-tail-left::after {
    border-right-color: #190f2a;
  }

  /* Mobile View (<680px): Mascot is ABOVE speech bubble -> Tail points UP */
  @media (max-width: 680px) {
    .speech-bubble-container {
      max-width: 100%;
      margin-top: 0.75rem;
    }

    .bubble-tail-left {
      left: 50%;
      top: -22px;
      bottom: auto;
      transform: translateX(-50%);
      border-left: 14px solid transparent;
      border-right: 14px solid transparent;
      border-top: none;
      border-bottom: 22px solid #111111;
    }

    .bubble-tail-left::after {
      left: -10px;
      top: 4px;
      border-left: 10px solid transparent;
      border-right: 10px solid transparent;
      border-top: none;
      border-bottom: 17px solid #ffffff;
    }

    body.theme-neon .bubble-tail-left {
      border-bottom-color: var(--neon-cyan);
      border-right-color: transparent;
    }

    body.theme-neon .bubble-tail-left::after {
      border-bottom-color: #190f2a;
      border-right-color: transparent;
    }
  }
</style>
